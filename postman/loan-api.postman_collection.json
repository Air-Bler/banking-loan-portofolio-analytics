          "name": "Exceptions for rule CUS-04, first page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"paged, customer keys hashed, no payload\", () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.total).to.be.a(\"number\");",
                  "    pm.expect(b.items.length).to.be.at.most(5);",
                  "    b.items.forEach(i => {",
                  "        pm.expect(i).to.not.have.property(\"record_payload\");",
                  "        if (i.entity === \"customers\") pm.expect(i.record_key).to.match(/^[0-9a-f]{16}$/);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
