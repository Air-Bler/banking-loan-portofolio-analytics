            ],
            "url": {
              "raw": "{{baseUrl}}/assistant/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assistant",
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Show the 30-day delinquency rate by branch.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
