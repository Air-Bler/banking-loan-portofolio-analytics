{
  "info": {
    "name": "Loan Portfolio Analytics API",
    "description": "Requests for every route of the API, with a test on each.\n\nVariables: `baseUrl` (http://127.0.0.1:8000 locally, the dev URL in CI) and `apiKey` (empty here: pass it at run time, never commit a real key).\n\nEvery request is also checked for an `X-Correlation-ID` response header.\n\nRun: `npx newman run postman/loan-api.postman_collection.json --env-var baseUrl=... --env-var apiKey=... --timeout-request 60000`. The Assistant folder needs AZURE_OPENAI_* configured; until then add `--folder Platform --folder Data --folder Errors`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"X-Correlation-ID header\", () => pm.response.to.have.header(\"X-Correlation-ID\"));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "apiKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Platform",
      "description": "Health, readiness and the API key check.",
      "item": [
        {
          "name": "Health (no key needed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Ready",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ready with an as-of date\", () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.status).to.eql(\"ready\");",
                  "    pm.expect(b.as_of_date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            }
          }
        },
        {
          "name": "Ready without a key -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"error format: unauthorized\", () => {",
                  "    const e = pm.response.json().error;",
                  "    pm.expect(e.code).to.eql(\"unauthorized\");",
                  "    pm.expect(e).to.have.all.keys(\"code\", \"message\", \"correlation_id\", \"details\");",
                  "    pm.expect(e.correlation_id).to.eql(pm.response.headers.get(\"X-Correlation-ID\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Ready with a wrong key -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"error format: unauthorized\", () => {",
                  "    const e = pm.response.json().error;",
                  "    pm.expect(e.code).to.eql(\"unauthorized\");",
                  "    pm.expect(e).to.have.all.keys(\"code\", \"message\", \"correlation_id\", \"details\");",
                  "    pm.expect(e.correlation_id).to.eql(pm.response.headers.get(\"X-Correlation-ID\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key"
                },
                {
                  "key": "value",
                  "value": "wrong-key"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Data",
      "description": "One request per data route, on real Gold data.",
      "item": [
        {
          "name": "Approval rate by branch, 2025",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"one row per branch, rates as ratios\", () => {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.metric.name).to.eql(\"approval_rate\");",
                  "    pm.expect(b.source).to.eql(\"gold.kpi_portfolio_monthly\");",
                  "    pm.expect(b.rows.length).to.be.above(0);",
                  "    b.rows.forEach(r => pm.expect(r.value).to.be.within(0, 1));",
                  "    pm.expect(b.correlation_id).to.eql(pm.response.headers.get(\"X-Correlation-ID\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analytics",
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metric\": \"approval_rate\",\n  \"group_by\": \"branch\",\n  \"filters\": {\n    \"date_from\": \"2025-01-01\",\n    \"date_to\": \"2025-12-31\"\n  },\n  \"limit\": 100\n}",
              "options": {
                "raw": {
