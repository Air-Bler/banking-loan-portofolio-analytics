                  "    pm.expect(b.evidence).to.be.an(\"array\").that.is.not.empty;",
                  "    pm.expect(b).to.include.keys(\"sources\", \"measures\", \"limitations\", \"correlation_id\");",
                  "});"
                ]
              }
